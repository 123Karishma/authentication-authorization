<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/head'); %>
</head>

<body class="container">


    <main>
        <div>
            <div>
                <form action="/verifyOtp" method="POST">
                    <input type="hidden" name="email" value="<%= email %>" />

                    <label>Enter OTP</label>

                    <input type="text" name="otp" placeholder="Enter OTP" required />

                    <button type="submit">
                        Verify OTP
                    </button>

            </div>
        </div>

    </main>



</body>

</html>